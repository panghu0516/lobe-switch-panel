# ===== Lobe 一键开关控制面板 · 环境变量模板 =====
# 复制为实际值填入 Sealos，绝不提交到代码仓库

# 端口（Sealos 里通常 3000）
PORT=3000

# GitHub OAuth App 凭证（在 https://github.com/settings/developers 创建）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://<面板域名>/auth/callback

# 白名单：只允许虎先生登录
ALLOWED_GITHUB_LOGIN=panghu0516

# Session 加密密钥（随机长字符串，可用: openssl rand -hex 32）
SESSION_SECRET=

# Sealos K8s API 地址（kubeconfig 里的 server 字段）
KUBE_API_SERVER=

# 最小权限 ServiceAccount 的 token（lobe-switch-sa）
KUBE_SA_TOKEN=

# 命名空间
KUBE_NAMESPACE=ns-feotrwac

# 应用清单（4 个纳管应用）
APPS_CONFIG=[{"name":"lobehub-v2","kind":"StatefulSet","replicas":1},{"name":"lobehub-paradedb","kind":"StatefulSet","replicas":1},{"name":"my-devbox","kind":"StatefulSet","replicas":1},{"name":"device-gateway","kind":"Deployment","replicas":1}]

# 状态持久化文件路径（挂载 PVC 到 /data）
STATE_FILE=/data/state.json

# ===== TOTP 动态码（方案②，可选但推荐）=====
# 不明填：首次访问 /totp/setup 生成密钥，用 Authenticator 扫码绑定后，把密钥填到这里
# 填后：登录(GitHub通过)后必须再输一次动态码才能操作
# 认证模式：github（只要GitHub）| totp（只要动态码）| both（两者都要，默认）
# 设为 totp 时跳过 GitHub 登录，仅需动态码；TOTP_SECRET 必须配置，否则拒绝访问
AUTH_MODE=both
TOTP_SECRET=

# ===== 模型服务商代理（v3，可选）=====
# 挂载在面板 3000 端口的 /v1/*，供 LobeHub 知识库向量化走集群内网（无需公网 Worker）
# LobeHub 服务商 BaseURL 填：http://<switch-panel-service>:3000/v1
# 可选：设置后代理要求请求携带 X-Proxy-Token 头，防公网滥用
EMBEDDING_PROXY_TOKEN=
