# ===== Lobe 一键开关控制面板 · 环境变量模板 =====
# 复制为实际值填入 Sealos，绝不提交到代码仓库

# 端口（Sealos 里通常 3000）
PORT=3000

# GitHub OAuth App 凭证（在 https://github.com/settings/developers 创建）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://<面板域名>/auth/callback

# 白名单：只允许虎先生登录
ALLOWED_GITHUB_LOGIN=panghu0516

# Session 加密密钥（随机长字符串，可用: openssl rand -hex 32）
SESSION_SECRET=

# Sealos K8s API 地址（kubeconfig 里的 server 字段）
KUBE_API_SERVER=

# 最小权限 ServiceAccount 的 token（lobe-switch-sa）
KUBE_SA_TOKEN=

# 命名空间
KUBE_NAMESPACE=ns-feotrwac

# 应用清单（4 个纳管应用）
APPS_CONFIG=[{"name":"lobehub-v2","kind":"StatefulSet","replicas":1},{"name":"lobehub-paradedb","kind":"StatefulSet","replicas":1},{"name":"my-devbox","kind":"StatefulSet","replicas":1},{"name":"device-gateway","kind":"Deployment","replicas":1}]

# 状态持久化文件路径（挂载 PVC 到 /data）
STATE_FILE=/data/state.json
